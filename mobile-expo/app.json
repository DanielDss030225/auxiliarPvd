        "foregroundImage": "./assets/iconMobile.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rppm.autoform",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "72bdc0e9-2f3f-4124-9402-472bb166a3d5"
      }
    }
  }
}