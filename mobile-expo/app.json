{
  "expo": {
    "name": "AutoForm RpPM",
    "slug": "autoform-rppm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconMobile.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
